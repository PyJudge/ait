diff --git a/ait.c b/ait.c
index adc3a93..717f2f4 100644
--- a/ait.c
+++ b/ait.c
@@ -1298,6 +1298,7 @@ static int remove_tree(struct strbuf *path)
 	size_t len = path->len;
 	int ret = 0, saved;
 
+	fprintf(stderr, "rt: opendir %s -> %p errno=%d\n", path->buf, (void *)dir, errno);
 	if (!dir)
 		return errno == ENOENT ? 0 : -1;
 	while (!ret && (e = readdir(dir))) {
@@ -1306,17 +1307,20 @@ static int remove_tree(struct strbuf *path)
 		if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, ".."))
 			continue;
 		strbuf_addf(path, "/%s", e->d_name);
+		fprintf(stderr, "rt: %s lstat=%d mode=%o errno=%d\n", path->buf, lstat(path->buf, &st), (unsigned)st.st_mode, errno);
 		if (lstat(path->buf, &st))
 			ret = errno == ENOENT ? 0 : -1;
 		else if (S_ISDIR(st.st_mode))
 			ret = remove_tree(path);
 		else
 			ret = unlink(path->buf) && errno != ENOENT ? -1 : 0;
+		fprintf(stderr, "rt: after %s ret=%d errno=%d\n", path->buf, ret, errno);
 		strbuf_setlen(path, len);
 	}
 	saved = errno;
 	closedir(dir);
 	errno = saved;
+	fprintf(stderr, "rt: rmdir %s ret=%d\n", path->buf, ret);
 	return ret ? ret : rmdir(path->buf);
 }
 
